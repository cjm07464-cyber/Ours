--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f109b9e25dfa6cc49af9f5ccf437358c, type: 3}
  m_Name: FatherPhoneCall
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 0}
    expressionId: 
    text: "\uC804\uD654\uAC00 \uC6B8\uB9B0\uB2E4."
    showPortrait: 0
    showSpeakerName: 0
    lineStartSound: {fileID: 8300000, guid: d90e74befadb4014a8ae124902e8eee1, type: 3}
    instantText: 1
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "{player}? \uC544\uBE60\uB2E4."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "\uC9D1\uC5D0\uC11C \uB098\uC654\uB2C8? \uC624\uB298\uC774 \uBC29\uD559\uC2DD\uC774\uC9C0?\n\uC544\uBE60\uB3C4
      \uCD9C\uC7A5 \uB54C\uBB38\uC5D0 \uC694\uC998 \uBC14\uC058\uB2E8\uB2E4."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "..\uADF8\uB798! A\uD0A4\uB97C \uB204\uB974\uBA74 \uC774\uAC83\uC800\uAC83
      \uB3C4\uC6C0\uC774 \uB420 \uB9CC\uD55C \uAC83\uB4E4\uC774 \uC788\uC744 \uAC70\uB2E4."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "\uC26C\uACE0 \uC2F6\uAC70\uB098 \uD53C\uACE4\uD558\uBA74 \uC5B8\uC81C\uB4E0
      \uC544\uBE60\uD55C\uD14C \uC804\uD654 \uC8FC\uB834.\n\uC544\uBE60\uAC00 \uC800\uC7A5\uD574
      \uC8FC\uB9C8."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "......\uC544\uBE60\uAC00 \uC694\uC998 \uC6B0\uB9AC \uC544\uB4E4\uC774\uB791\n\uC790\uC8FC
      \uBABB \uB9CC\uB098\uC11C \uBBF8\uC548\uD558\uAD6C\uB098... \uC774\uD574\uD574
      \uC8FC\uB834."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "\uBE44\uB85D \uC9C0\uAE08\uC740 \uC5C4\uB9C8\uC640 \uB530\uB85C \uC0B4\uACE0
      \uC788\uC9C0\uB9CC,\n\uC544\uBE60\uB294 \uC5B8\uC81C\uB098 \uC6B0\uB9AC {player}
      \uD3B8\uC774\uB780\uB2E4."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "\uC5B4\uB838\uC744 \uB54C\uBD80\uD130 \uB10C \uB0A8\uB4E4\uACFC \uB2EC\uB9AC
      \uD2B9\uBCC4\uD55C \uD798\uC774 \uC788\uC5C8\uACE0, \uAC15\uD55C \uC544\uC774\uC600\uC73C\uB2C8\uAE4C.
      \n\uC55E\uC73C\uB85C\uB3C4 \uBB38\uC81C\uC5C6\uC744 \uAC70\uB77C\uACE0 \uC544\uBE60\uB294
      \uBBFF\uB294\uB2E4."
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 11400000, guid: fb5dda8eeb7bd154893356e9360e71d4, type: 2}
    expressionId: normal
    text: "\uADF8\uB7FC \uB610 \uBCF4\uC790.\n\uC26C\uACE0 \uC2F6\uC744 \uB550 \uC5B8\uC81C\uB4E0
      \uC804\uD654 \uC8FC\uB834!"
    showPortrait: 1
    showSpeakerName: 1
    lineStartSound: {fileID: 0}
    instantText: 0
  - speaker: {fileID: 0}
    expressionId: 
    text: ".......\uC091!"
    showPortrait: 0
    showSpeakerName: 0
    lineStartSound: {fileID: 8300000, guid: 009db325fbc9d6c409104e703bf40f63, type: 3}
    instantText: 0
