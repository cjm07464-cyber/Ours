  lines:
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "\uC798\uC7A4\uB2C8 {player}?"
    showPortrait: 1
    showSpeakerName: 1
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "...\uB610 \uAFC8\uC774\uB77C\uB3C4 \uAFBC \uAC70\uB2C8?"
    showPortrait: 1
    showSpeakerName: 1
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "\uAFC8\uC744 \uAFBC\uB2E4\uB294 \uAC74 \uC5B4\uC81C\uB3C4 \uC778\uC0C1\uC801\uC778
      \uD558\uB8E8\uC600\uB2E4\uB294 \uAC83 \uC544\uB2C8\uACA0\uC5B4?"
    showPortrait: 1
    showSpeakerName: 1
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "\uC624\uB298\uBD80\uD130 \uBC29\uD559\uC2DD\uC774\uC9C0? \uD559\uAD50
      \uC798 \uB2E4\uB140\uC624\uB834."
    showPortrait: 1
    showSpeakerName: 1
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "\uC544..! \uB9DE\uC544! \uBC29\uB9DD\uC774 \uCC59\uAE30\uB294 \uAC70 \uC78A\uC9C0\uB9D0\uACE0.\n\uC694\uC998
      \uD749\uD749\uD558\uC796\uB2C8. \uAE38\uAC70\uB9AC \uB3D9\uBB3C\uB4E4\uC774
      \uC0AC\uB098\uC6CC\uC838\uC11C..."
    showPortrait: 1
    showSpeakerName: 1
  - speaker: {fileID: 11400000, guid: b453b1abd211ec741aae17e0b101d4a4, type: 2}
    expressionId: normal
    text: "\uB108\uB77C\uBA74 \uAD1C\uCC2E\uACA0\uC9C0\uB9CC.\n\uB2E4\uCE58\uC9C0
      \uB9D0\uACE0 \uC798 \uB2E4\uB140\uC624\uB834."
    showPortrait: 1
    showSpeakerName: 1
