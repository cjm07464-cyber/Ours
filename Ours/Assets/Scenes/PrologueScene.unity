  dialogueController: {fileID: 1316994068}
  meteorDialogues:
  - "6\uAC1C\uC6D4 \uC804,\n\uBCA8\uC6B0\uB4DC \uCE74\uC6B4\uD2F0 \uC77C\uB300\uC5D0\n\uC815\uCCB4\uBD88\uBA85\uC758
    \uC6B4\uC11D\uC774 \uB099\uD558\uD588\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uD589\uD788 \uC778\uBA85 \uD53C\uD574\uB294 \uC5C6\uC5C8\uC9C0\uB9CC,\n\uC0AC\uAC74
    \uC774\uD6C4 \uD574\uB2F9 \uC9C0\uC5ED\uC740\n\uACC4\uC18D\uD574\uC11C \uAD00\uCC30
    \uB300\uC0C1\uC774 \uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  researchDialogues:
  - "\uD558\uC9C0\uB9CC \uCD5C\uADFC \uBCA8\uC6B0\uB4DC \uCE74\uC6B4\uD2F0 \uACF3\uACF3\uC5D0\uC11C\n\uB3D9\uBB3C\uACFC
    \uC2DD\uBB3C\uC758 \uC0DD\uD0DC \uBCC0\uD654 \uB4F1\n\uC774\uC0C1 \uD604\uC0C1\uC774
    \uBC1C\uACAC\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD604\uC7AC\uAE4C\uC9C0 \uC0AC\uB78C\uC5D0\uAC8C\uC11C \uC774\uC0C1 \uC99D\uC0C1\uC740
    \uBCF4\uACE0\uB418\uC9C0 \uC54A\uC558\uC73C\uBA70,\n\uC2E0\uADDC \uD2B9\uC218
    \uBC14\uC774\uB7EC\uC2A4\uC758 \uAC00\uB2A5\uC131\uC774 \uC81C\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC624\uB298\uB3C4
    \uC5F0\uAD6C\uC9C4\uC740 \uC6D0\uC778\uC744 \uACC4\uC18D \uC870\uC0AC \uC911\uC785\uB2C8\uB2E4."
